# --- SERVER CONFIGURATION ---
PORT=5000
# The port on which the Express server will run.

# --- DATABASE (REQUIRED) ---
MONGO_URI= mongodb://127.0.0.1:27017/adpromoter
# Your MongoDB connection string. Get it from MongoDB Atlas.

# --- SECURITY (REQUIRED) ---
JWT_SECRET=any_long_random_string_here
# Secret key used to sign JWT tokens for authentication. Keep this very secure.

# --- FRONTEND CONNECTIVITY ---
FRONTEND_URL=http://localhost:5173
# The URL of your React frontend to allow CORS requests.

# --- FILE UPLOADS (CLOUDINARY) - (REQUIRED for campaigns) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Get these from your Cloudinary Dashboard (cloudinary.com).

# --- EMAIL SERVICE (OPTIONAL) ---
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_mailtrap_user
EMAIL_PASS=your_mailtrap_password
# Used for sending email notifications. Mailtrap is recommended for testing.
